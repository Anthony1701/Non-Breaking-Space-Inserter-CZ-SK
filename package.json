{
  "name": "nbsp-inserter",
  "displayName": "Non-Breaking Space Inserter CZ/SK",
  "description": "Automatically inserts non-breaking spaces (&nbsp;) according to Czech and Slovak typographic rules",
  "version": "1.0.1",
  "publisher": "antonin-simkanin",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#182238",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anthony1701/Non-Breaking-Space-Inserter-CZ-SK.git"
  },
  "bugs": {
    "url": "https://github.com/Anthony1701/Non-Breaking-Space-Inserter-CZ-SK/issues"
  },
  "homepage": "https://github.com/Anthony1701/Non-Breaking-Space-Inserter-CZ-SK#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "nbsp",
    "non-breaking space",
    "czech",
    "slovak",
    "typography",
    "formatting"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nbsp.insertInSelection",
        "title": "Insert &nbsp; in Selection",
        "category": "NBSP"
      },
      {
        "command": "nbsp.insertInDocument",
        "title": "Insert &nbsp; in Entire Document",
        "category": "NBSP"
      },
      {
        "command": "nbsp.insertInLine",
        "title": "Insert &nbsp; in Current Line",
        "category": "NBSP"
      }
    ],
    "keybindings": [
      {
        "command": "nbsp.insertInSelection",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Non-Breaking Space Inserter",
      "properties": {
        "nbspInserter.enableCzechRules": {
          "type": "boolean",
          "default": true,
          "description": "Enable Czech typographic rules"
        },
        "nbspInserter.enableSlovakRules": {
          "type": "boolean",
          "default": true,
          "description": "Enable Slovak typographic rules"
        },
        "nbspInserter.autoDetectLanguage": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect language and apply appropriate rules"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --readme-path MARKETPLACE.md",
    "publish": "vsce publish --readme-path MARKETPLACE.md"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^4.9.4"
  }
}
